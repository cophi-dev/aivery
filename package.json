{
  "name": "aivery-new",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "dev:fix-buffer": "node scripts/fix-buffer-errors.js",
    "build": "prisma generate && next build",
    "build:dynamic": "NEXT_DISABLE_STATIC_GENERATION=true NEXT_FORCE_DYNAMIC=true NEXT_RUNTIME=nodejs prisma generate && next build",
    "build:super-fresh": "rm -rf .next && rm -rf node_modules/.cache && NEXT_DISABLE_STATIC_GENERATION=true NEXT_FORCE_DYNAMIC=true NEXT_RUNTIME=nodejs NEXT_DISABLE_CACHE=1 prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "clean-vercel": "rm -rf .next && rm -rf .vercel/output",
    "deploy:force": "npm run clean-vercel && NEXT_DISABLE_STATIC_GENERATION=true NEXT_FORCE_DYNAMIC=true NEXT_RUNTIME=nodejs vercel --prod",
    "deploy:clear-cache": "npm run clean-vercel && VERCEL_FORCE_NO_BUILD_CACHE=1 NEXT_DISABLE_STATIC_GENERATION=true NEXT_FORCE_DYNAMIC=true NEXT_RUNTIME=nodejs NEXT_DISABLE_CACHE=1 vercel --prod --force"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.2.7",
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@stripe/stripe-js": "^7.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.16",
    "ai": "^4.1.64",
    "autoprefixer": "^10.0.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "fit-file-parser": "^1.21.0",
    "framer-motion": "^12.6.2",
    "gpxparser": "^3.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.483.0",
    "mongodb": "^6.15.0",
    "mongoose": "^8.12.1",
    "next": "14.1.0",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "openai": "4.20.1",
    "postcss": "^8",
    "prisma": "^6.5.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
