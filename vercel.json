{
  "functions": {
    "src/app/api/strava/import/route": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/api/quotes/route": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "VERCEL_BODY_SIZE_LIMIT": "100mb"
    }
  },
  "headers": [
    {
      "source": "/api/quotes",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/strava/import",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
} 