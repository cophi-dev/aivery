{
  "functions": {
    "src/app/api/strava/import/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/strava/import",
      "methods": ["POST"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST",
        "Access-Control-Allow-Headers": "Content-Type"
      },
      "continue": true
    }
  ],
  "build": {
    "env": {
      "VERCEL_BODY_SIZE_LIMIT": "100mb"
    }
  }
} 