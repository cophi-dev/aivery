generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workouts      Workout[]
  preferences   UserPreferences?

  @@map("users")
}

model Workout {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  date          DateTime
  type          String
  duration      Int
  intensity     String
  distance      Float?
  calories      Int?
  notes         String?
  cardioDetails Json?
  strengthDetails Json?
  flexibilityDetails Json?
  importedFrom  String?
  importId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id])
  exercises     WorkoutExercise[]

  @@map("workouts")
}

model UserPreferences {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @unique @db.ObjectId
  user              User     @relation(fields: [userId], references: [id])
  preferredWeightUnit String @default("kg")
  preferredHeightUnit String @default("cm")
  preferredDistanceUnit String @default("km")
  restTimerEnabled  Boolean  @default(true)
  defaultRestTime   Int      @default(60)
  workoutReminders  Boolean  @default(true)
  weeklyWorkoutGoal Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("preferences")
}

model Exercise {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String     @unique
  description     String?
  muscleGroups    String[]
  category        String     @default("strength") // strength, cardio, flexibility
  equipment       String[]
  instructions    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workoutExercises WorkoutExercise[]

  @@map("exercises")
}

model WorkoutExercise {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workoutId   String   @db.ObjectId
  workout     Workout  @relation(fields: [workoutId], references: [id])
  exerciseId  String   @db.ObjectId
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  order       Int?     // Optional field to maintain order of exercises within a workout
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workoutexercises")
} 